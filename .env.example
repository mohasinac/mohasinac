# mohasinac.com — copy to .env.local and fill in. Never commit .env.local.

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME="Mohasin A C"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Firebase (client SDK — used for AUTH ONLY) ──────────────────────────────
# 🛑 Firestore/Storage client SDKs are never used: firestore.rules denies all
# client access and every read/write goes through an API route with the Admin
# SDK. These values are only here so Firebase Auth can run in the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ─── Firebase Admin (server only) ────────────────────────────────────────────
# Paste the private key with literal \n escapes, wrapped in double quotes.
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""
FIREBASE_ADMIN_STORAGE_BUCKET=""
FIREBASE_ADMIN_DATABASE_URL=""

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM=""
EMAIL_FROM_NAME="mohasinac.com"

# ─── Rate limiting (Upstash Redis) ───────────────────────────────────────────
# Optional in dev: appkit's rate limiter falls back to an in-memory store when
# these are absent, which is per-process and therefore useless on serverless.
# Required in production.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Admin bootstrap ─────────────────────────────────────────────────────────
# Email granted the admin role on first sign-in. Used once to seed the first
# admin; role changes thereafter happen in the admin console.
ADMIN_BOOTSTRAP_EMAIL=""
