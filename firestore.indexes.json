{
  "//": [
    "Composite indexes required by this app.",
    "",
    "Firestore auto-indexes single fields, but ANY query combining two or more",
    "field constraints needs an explicit composite index — including two",
    "equality filters, not just equality plus orderBy. Without these, every",
    "public list query fails with FAILED_PRECONDITION; listPublished() catches",
    "it and falls back to the bundled content files, so the site renders but",
    "silently serves stale data instead of the CMS. That failure is invisible",
    "unless you read the server logs, which is why this file exists.",
    "",
    "Deploy with:  firebase deploy --only firestore:indexes --project mohasinac-com",
    "(requires the Firebase CLI and an interactive login; the Admin SDK cannot",
    "create indexes.)"
  ],
  "indexes": [
    {
      "//": "listPublished: status == 'published' + orderBy(sortOrder)",
      "collectionGroup": "projects",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "sortOrder", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "tools",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "sortOrder", "order": "ASCENDING" }
      ]
    },
    {
      "//": "certifications order by issuedAt DESC, not sortOrder",
      "collectionGroup": "certifications",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "issuedAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "hobbies",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "sortOrder", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "businesses",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "sortOrder", "order": "ASCENDING" }
      ]
    },
    {
      "//": "blogPosts order by publishedAt DESC",
      "collectionGroup": "blogPosts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "publishedAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "courseTracks",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "sortOrder", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "courseModules",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "sortOrder", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "lessons",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "sortOrder", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "problems",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "sortOrder", "order": "ASCENDING" }
      ]
    },
    {
      "//": "listChildren('modules', 'trackSlug', …): two equality filters",
      "collectionGroup": "courseModules",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "trackSlug", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" }
      ]
    },
    {
      "//": "listChildren('lessons', 'moduleSlug', …)",
      "collectionGroup": "lessons",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "moduleSlug", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" }
      ]
    },
    {
      "//": "POST /api/course/submit: per-user daily submission cap",
      "collectionGroup": "submissions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "uid", "order": "ASCENDING" },
        { "fieldPath": "at", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Problem list: which problems has this user solved",
      "collectionGroup": "userProgress",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "uid", "order": "ASCENDING" },
        { "fieldPath": "solved", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
