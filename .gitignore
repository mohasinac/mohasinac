# dependencies
node_modules/
jspm_packages/
.pnp
.pnp.js

# next
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# the in-browser C++ toolchain: ~119 MB staged from node_modules by
# scripts/build-toolchain-assets.mjs at prebuild. Never commit it — it is also
# what keeps the deployment under Vercel's source-upload limit.
/public/toolchain/

# the appkit build-host worktree, if checked out inside this repo
/appkit/

# env — only .env.example is tracked
.env
.env.*
!.env.example

# secrets: a Firebase service-account JSON must never land in the repo
*-firebase-adminsdk-*.json
firebase-admin-key.json
service-account*.json

# logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# build / tooling output
.vercel
.eslintcache
coverage
*.lcov
.nyc_output
.cache
*.tgz

# runtime data
pids
*.pid
*.seed
*.pid.lock
.node_repl_history

# editor / OS
.DS_Store
Thumbs.db
*.swp
.tern-port

.vercel
.env*

# re-assert after the .env* rule Vercel appends on `vercel link`:
# last matching rule wins, and .env.example must stay tracked.
!.env.example

# The vendored appkit package. npm publishing is blocked on this account
# (granular token, no publish rights; 2FA needs an interactive OTP), so the
# branch build ships as a real packed tarball instead. See readme.md.
!vendor/*.tgz
